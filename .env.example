# Resend (https://resend.com) — for sending the PDF estimate by email
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=estimates@yourdomain.com

# Protects GET /api/leads — pick any long random string
ADMIN_SECRET=change-me-to-something-long-and-random

# One of these pairs is injected automatically once you connect a Redis
# (Upstash) database to this project from the Vercel Marketplace — you don't
# set these by hand. Run `vercel env pull .env.local` to see which pair you
# actually got:
#   KV_REST_API_URL / KV_REST_API_TOKEN            (legacy naming)
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (native naming)
